{
  "name": "ct-c-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only CodeTantra C practice assistant (Manifest V3)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "manifest": "node tools/generate-manifest.mjs",
    "build": "npm run manifest && tsc --noEmit && vite build",
    "build:test": "node tools/generate-manifest.mjs --test-host && tsc --noEmit && vite build --mode test",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:helper": "node --test helper/tests/*.test.mjs",
    "test:e2e": "npm run build:test && playwright test",
    "forbidden": "vitest run tools/forbidden-apis.test.ts",
    "helper": "node helper/server.mjs",
    "helper:init": "node helper/init.mjs",
    "helper:check": "node helper/check.mjs",
    "verify": "npm run lint && npm run forbidden && npm run test:unit && npm run build && npm run test:helper",
    "prepare:hooks": "node tools/install-hooks.mjs"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/chrome": "0.1.24",
    "@types/node": "22.18.12",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.1",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
